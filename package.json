{
  "name": "miniagent",
  "version": "1.0.0",
  "description": "A minimal prompt-driven coding agent for the terminal",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "miniagent": "./dist/src/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "server": "tsx src/server/main.ts",
    "cli": "tsx src/ui-cli/main.ts",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts test/**/*.test.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && oxfmt src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
